{
  "appId": "com.helixora.app",
  "appName": "Helixora",
  "webDir": "dist",
  "backgroundColor": "#ffffff",
  "ios": {
    "contentInset": "never",
    "scheme": "Helixora"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 1500,
      "backgroundColor": "#0E2A2E",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
